	"item": [
		{
			"name": "Login (GET /api/motos)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// monta header Basic com as variáveis do environment\r",
							"const user = pm.environment.get(\"adminUser\") || \"\";\r",
							"const pass = pm.environment.get(\"adminPass\") || \"\";\r",
							"const raw = `${user}:${pass}`;\r",
							"const b64 = typeof btoa === \"function\" ? btoa(raw) : Buffer.from(raw).toString(\"base64\");\r",
							"pm.environment.set(\"basicAuth\", b64);\r",
							"pm.request.headers.upsert({ key: \"Authorization\", value: `Basic ${b64}` });\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
							"pm.test(\"Response is JSON\", () => pm.response.to.be.json);\r",
							"pm.test(\"Response is array or page object\", () => {\r",
							"  const json = pm.response.json();\r",
							"  pm.expect(Array.isArray(json) || json.hasOwnProperty(\"content\")).to.be.true;\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "password",
							"value": "{{password}}",
							"type": "string"
						},
						{
							"key": "username",
							"value": "{{username}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Basic {{basicAuth}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/motos",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"motos"
					]
				}
			},
			"response": []
		},
		{
			"name": "Criar Pátio (POST /api/patios)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200 or 201\", () => {\r",
							"  pm.expect(pm.response.code === 200 || pm.response.code === 201).to.be.true;\r",
							"});\r",
							"pm.test(\"Response has id and nome\", () => {\r",
							"  const json = pm.response.json();\r",
							"  pm.expect(json).to.have.property(\"id\");\r",
							"  pm.expect(json.nome).to.eql(\"Patio Autotest\");\r",
							"});\r",
							"if (pm.response.code === 200 || pm.response.code === 201) {\r",
							"  const json = pm.response.json();\r",
							"  pm.environment.set(\"patioIdCreated\", json.id);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "password",
							"value": "{{password}}",
							"type": "string"
						},
						{
							"key": "username",
							"value": "{{username}}",
							"type": "string"
