		{
			"name": "Criar Moto (POST /api/motos)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status is 200 or 201\", () => {\r",
							"  pm.expect(pm.response.code === 200 || pm.response.code === 201).to.be.true;\r",
							"});\r",
							"pm.test(\"Response has id, placa and patio\", () => {\r",
							"  const json = pm.response.json();\r",
							"  pm.expect(json).to.have.property(\"id\");\r",
							"  pm.expect(json).to.have.property(\"placa\");\r",
							"  pm.expect(json).to.have.property(\"patio\");\r",
							"});\r",
							"\r",
							"// save id and placa for later\r",
							"const json = pm.response.json();\r",
							"if (json && json.id) {\r",
							"  pm.environment.set(\"motoIdCreated\", json.id);\r",
							"  pm.environment.set(\"motoPlacaCreated\", json.placa);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
